<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TutorBook — запись к репетитору</title>
    <script>
      (function () {
        var stored = localStorage.getItem("tutorbook-theme");
        var dark =
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches);
        if (dark) document.documentElement.classList.add("dark");
      })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              alabaster: "#FAF7F9",
              ivory: "#FFFFFF",
              emeraldink: "#1F1624",
              forest: "#1F1624",
              moss: "#6B21A8",
              gold: "#6B21A8",
              lilac: "#F3E8FF",
              line: "#EAE2E8",
              night: "#110C15",
              dusk: "#1B1422",
              linight: "#2E2238",
              mist: "#F5F0F7",
              amethyst: "#A855F7",
            },
            fontFamily: {
              display: ['"Cormorant Garamond"', "Georgia", "serif"],
              sans: ['"Sora"', "system-ui", "sans-serif"],
            },
            boxShadow: {
              book: "0 24px 60px -28px rgba(107, 33, 168, 0.28)",
            },
          },
        },
      };
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Sora:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      .choice-card:hover:not(:has(input:checked)) {
        background: #f3e8ff;
        border-color: #eae2e8;
      }
      .dark .choice-card:hover:not(:has(input:checked)) {
        background: #2e2238;
        border-color: #2e2238;
      }
      .choice-card:has(input:checked) {
        border-color: #6b21a8;
        background: #6b21a8;
        color: #ffffff;
      }
      .dark .choice-card:has(input:checked) {
        border-color: #a855f7;
        background: #a855f7;
        color: #110c15;
      }
      .slot-pill[aria-pressed="true"] {
        background: #6b21a8;
        color: #ffffff;
        border-color: #6b21a8;
      }
      .dark .slot-pill[aria-pressed="true"] {
        background: #a855f7;
        color: #110c15;
        border-color: #a855f7;
      }
      .pay-card[aria-pressed="true"] {
        border-color: #6b21a8;
        background: #6b21a8;
        color: #ffffff;
      }
      .dark .pay-card[aria-pressed="true"] {
        border-color: #a855f7;
        background: #a855f7;
        color: #110c15;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-alabaster text-emeraldink font-sans dark:bg-night dark:text-mist">
    <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-12">
      <header class="mb-10 flex items-center justify-between gap-4">
        <a href="/" class="font-display text-3xl tracking-tight text-emeraldink dark:text-mist">TutorBook</a>
        <div class="flex items-center gap-2">
          <% if (telegramLink) { %>
          <a
            href="<%= telegramLink %>"
            class="rounded-full border border-line px-4 py-2 text-sm text-emeraldink transition hover:border-moss dark:border-linight dark:text-mist"
            >Telegram</a
          >
          <% } %>
          <button
            id="theme-toggle"
            type="button"
            class="rounded-full border border-line px-4 py-2 text-sm dark:border-linight"
            aria-label="Переключить тему"
          >
            Тема
          </button>
        </div>
      </header>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
        <aside class="lg:col-span-5">
          <div class="lg:sticky lg:top-8">
            <p class="text-sm text-moss dark:text-mist/80">Индивидуальные занятия с носителями и сертифицированными преподавателями</p>
            <h1 class="mt-3 font-display text-4xl leading-[1.12] text-forest dark:text-ivory sm:text-5xl">
              Забронируйте время для вашего прогресса
            </h1>
            <p class="mt-4 max-w-md text-base leading-relaxed text-emeraldink/75 dark:text-mist/75">
              Выберите направление и удобное окно в расписании. После записи я напишу вам в Telegram, чтобы познакомиться и отправить ссылку на встречу.
            </p>

            <ul class="mt-8 space-y-3">
              <li class="rounded-2xl border border-line bg-ivory px-5 py-4 dark:border-linight dark:bg-dusk">
                <p class="font-medium">Персональная программа под вашу цель</p>
                <p class="mt-1 text-sm text-emeraldink/65 dark:text-mist/70">Говорение, экзамен или уверенность в поездке — план собирается вокруг вас.</p>
              </li>
              <li class="rounded-2xl border border-line bg-ivory px-5 py-4 dark:border-linight dark:bg-dusk">
                <p class="font-medium">Бесплатный вводный урок-диагностика 30 мин</p>
                <p class="mt-1 text-sm text-emeraldink/65 dark:text-mist/70">Определим уровень и понятный следующий шаг без оплаты.</p>
              </li>
              <li class="rounded-2xl border border-line bg-ivory px-5 py-4 dark:border-linight dark:bg-dusk">
                <p class="font-medium">Гибкий перенос занятий за 12 часов</p>
                <p class="mt-1 text-sm text-emeraldink/65 dark:text-mist/70">Жизнь меняется — достаточно предупредить заранее.</p>
              </li>
            </ul>

            <div class="mt-8 rounded-3xl border border-line bg-ivory p-6 dark:border-linight dark:bg-dusk">
              <p class="font-display text-2xl text-forest dark:text-ivory">Ваш урок</p>
              <dl class="mt-4 space-y-3 text-sm">
                <div class="flex justify-between gap-4">
                  <dt class="text-emeraldink/55 dark:text-mist/55">Язык</dt>
                  <dd id="summary-language" class="text-right">Не выбран</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-emeraldink/55 dark:text-mist/55">Преподаватель</dt>
                  <dd id="summary-teacher" class="text-right">Выберите язык</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-emeraldink/55 dark:text-mist/55">Формат</dt>
                  <dd id="summary-service" class="text-right">Выберите услугу</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-emeraldink/55 dark:text-mist/55">Когда</dt>
                  <dd id="summary-when" class="text-right">Дата и время</dd>
                </div>
                <div class="flex justify-between gap-4 border-t border-line pt-3 dark:border-linight">
                  <dt class="text-emeraldink/55 dark:text-mist/55">Стоимость</dt>
                  <dd id="summary-price" class="font-display text-2xl leading-none text-forest dark:text-ivory">—</dd>
                </div>
              </dl>
            </div>
          </div>
        </aside>

        <section class="lg:col-span-7">
          <% if (paid) { %>
          <p class="mb-5 rounded-2xl border border-moss/30 bg-ivory px-5 py-4 text-sm dark:border-amethyst/30 dark:bg-dusk" role="status">
            Оплата прошла успешно. Запись подтверждена — я напишу вам в Telegram.
          </p>
          <% } else if (canceled) { %>
          <p class="mb-5 rounded-2xl border border-moss/30 bg-ivory px-5 py-4 text-sm dark:border-linight dark:bg-dusk" role="status">
            Оплата отменена. Слот пока забронирован — выберите способ оплаты ещё раз или запишитесь заново.
          </p>
          <% } else if (receipt) { %>
          <p class="mb-5 rounded-2xl border border-moss/30 bg-ivory px-5 py-4 text-sm dark:border-amethyst/30 dark:bg-dusk" role="status">
            Чек получен и отправлен преподавателю на проверку. Мы подтвердим запись после проверки.
          </p>
          <% } else if (success) { %>
          <p class="mb-5 rounded-2xl border border-moss/30 bg-ivory px-5 py-4 text-sm dark:border-amethyst/30 dark:bg-dusk" role="status">
            Запись принята. Пробный урок бесплатный — я напишу вам в Telegram, чтобы познакомиться и прислать ссылку на встречу.
          </p>
          <% } %>
          <% if (error) { %>
          <p class="mb-5 rounded-2xl border border-moss/30 bg-ivory px-5 py-4 text-sm dark:border-linight dark:bg-dusk" role="alert">
            Это время только что заняли или форма заполнена не полностью. Выберите другое окно в расписании.
          </p>
          <% } %>

          <form
            id="booking-form"
            action="/book"
            method="POST"
            class="rounded-3xl border border-line bg-ivory p-8 shadow-book dark:border-linight dark:bg-dusk md:p-10"
          >
            <fieldset class="min-w-0">
              <legend class="flex items-baseline gap-3">
                <span class="font-display text-2xl text-gold">01</span>
                <span class="font-display text-3xl text-forest dark:text-ivory">Формат обучения</span>
              </legend>

              <p class="mt-6 text-sm text-emeraldink/60 dark:text-mist/60">Язык</p>
              <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                <% languages.forEach(function (language, index) { %>
                <label class="choice-card cursor-pointer rounded-2xl border border-line bg-alabaster/80 px-3 py-3 text-center text-sm transition hover:border-moss dark:border-linight dark:bg-night/40">
                  <input class="sr-only" type="radio" name="language" value="<%= language %>" <%= index === 0 ? "required" : "" %> />
                  <%= language %>
                </label>
                <% }) %>
              </div>
              <input id="teacher_id" name="teacher_id" type="hidden" value="" />
              <div
                id="teacher-card"
                hidden
                class="mt-4 rounded-2xl border border-line bg-lilac/70 px-4 py-4 dark:border-linight dark:bg-night/50"
              >
                <p class="text-sm text-emeraldink/55 dark:text-mist/55">Ваш преподаватель</p>
                <div id="teacher-single">
                  <p id="teacher-card-name" class="mt-1 font-display text-2xl text-forest dark:text-ivory"></p>
                  <p id="teacher-card-title" class="mt-1 text-sm leading-relaxed text-emeraldink/70 dark:text-mist/70"></p>
                </div>
                <div id="teacher-list" class="mt-3 hidden space-y-2"></div>
              </div>

              <p class="mt-7 text-sm text-emeraldink/60 dark:text-mist/60">Услуга</p>
              <div class="mt-3 grid gap-3">
                <% services.forEach(function (service, index) { %>
                <% var duration = (service.name.match(/\(([^)]+)\)/) || [])[1] || ""; %>
                <label
                  class="choice-card cursor-pointer rounded-2xl border border-line bg-alabaster/80 px-4 py-4 transition hover:border-moss dark:border-linight dark:bg-night/40"
                  data-price="<%= service.price %>"
                  data-amount="<%= service.amount %>"
                  data-duration="<%= duration %>"
                >
                  <input class="sr-only" type="radio" name="service" value="<%= service.name %>" <%= index === 0 ? "required" : "" %> />
                  <span class="flex items-start justify-between gap-4">
                    <span>
                      <span class="block font-medium leading-snug"><%= service.name.replace(/\s*\([^)]+\)\s*$/, "") %></span>
                      <span class="mt-1 block text-sm text-current/70"><%= duration %></span>
                    </span>
                    <span class="shrink-0 font-display text-xl leading-none"><%= service.price %></span>
                  </span>
                </label>
                <% }) %>
              </div>
            </fieldset>

            <fieldset class="mt-10 min-w-0">
              <legend class="flex items-baseline gap-3">
                <span class="font-display text-2xl text-gold">02</span>
                <span class="font-display text-3xl text-forest dark:text-ivory">Дата и время</span>
              </legend>
              <label class="mt-6 block">
                <span class="text-sm text-emeraldink/60 dark:text-mist/60">Дата</span>
                <input
                  id="date"
                  name="date"
                  type="date"
                  required
                  min="<%= today %>"
                  class="mt-2 w-full rounded-2xl border border-line bg-alabaster/80 px-4 py-3.5 text-sm outline-none transition focus:border-moss focus:ring-4 focus:ring-moss/15 dark:border-linight dark:bg-night/40 dark:focus:border-amethyst dark:focus:ring-amethyst/15"
                />
              </label>
              <p class="mt-5 text-sm text-emeraldink/60 dark:text-mist/60">Свободное время</p>
              <input
                id="time_slot"
                name="time_slot"
                type="text"
                required
                tabindex="-1"
                autocomplete="off"
                class="sr-only"
                aria-label="Выбранное время"
              />
              <div id="slot-grid" class="mt-3 flex flex-wrap gap-2">
                <p id="slot-hint" class="text-sm text-emeraldink/55 dark:text-mist/55">Сначала выберите дату — появятся свободные окна.</p>
              </div>
            </fieldset>

            <fieldset class="mt-10 min-w-0">
              <legend class="flex items-baseline gap-3">
                <span class="font-display text-2xl text-gold">03</span>
                <span class="font-display text-3xl text-forest dark:text-ivory">Контакты для связи</span>
              </legend>
              <div class="mt-6 space-y-4">
                <label class="block">
                  <span class="text-sm text-emeraldink/60 dark:text-mist/60">Ваше имя</span>
                  <span class="relative mt-2 block">
                    <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-moss dark:text-mist" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <circle cx="12" cy="8" r="3.2" />
                      <path d="M5 19c1.4-3.2 4-5 7-5s5.6 1.8 7 5" />
                    </svg>
                    <input
                      name="student_name"
                      required
                      maxlength="100"
                      autocomplete="name"
                      placeholder="Как к вам обращаться"
                      class="w-full rounded-2xl border border-line bg-alabaster/80 py-3.5 pl-11 pr-4 text-sm outline-none transition placeholder:text-emeraldink/35 focus:border-moss focus:ring-4 focus:ring-moss/15 dark:border-linight dark:bg-night/40 dark:placeholder:text-mist/35 dark:focus:border-amethyst dark:focus:ring-amethyst/15"
                    />
                  </span>
                </label>
                <label class="block">
                  <span class="text-sm text-emeraldink/60 dark:text-mist/60">Telegram или телефон</span>
                  <span class="relative mt-2 block">
                    <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-moss dark:text-mist" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                      <path d="M5 8.5c0-2 1.7-3.5 4-3.5h6c2.3 0 4 1.5 4 3.5v7c0 2-1.7 3.5-4 3.5h-6c-2.3 0-4-1.5-4-3.5v-7z" />
                      <path d="M8 10.5h8M8 14h5" />
                    </svg>
                    <input
                      name="contact"
                      required
                      maxlength="100"
                      autocomplete="tel"
                      placeholder="@username или +998"
                      class="w-full rounded-2xl border border-line bg-alabaster/80 py-3.5 pl-11 pr-4 text-sm outline-none transition placeholder:text-emeraldink/35 focus:border-moss focus:ring-4 focus:ring-moss/15 dark:border-linight dark:bg-night/40 dark:placeholder:text-mist/35 dark:focus:border-amethyst dark:focus:ring-amethyst/15"
                    />
                  </span>
                </label>
              </div>
            </fieldset>

            <fieldset id="payment-step" class="mt-10 min-w-0" hidden>
              <legend class="flex items-baseline gap-3">
                <span class="font-display text-2xl text-gold">04</span>
                <span class="font-display text-3xl text-forest dark:text-ivory">Способ оплаты</span>
              </legend>
              <input id="payment_method" name="payment_method" type="hidden" value="free" />
              <input id="receipt_data" name="receipt_data" type="hidden" value="" />
              <div class="mt-6 grid gap-3">
                <button type="button" class="pay-card choice-card cursor-pointer rounded-2xl border border-line bg-alabaster/80 px-4 py-4 text-left dark:border-linight dark:bg-night/40" data-method="stripe">
                  <span class="block font-medium">💳 Банковская карта (Stripe)</span>
                  <span class="mt-1 block text-sm text-current/70">Официальный Stripe Checkout. В тесте используйте карту 4242… и 3D Secure банка.</span>
                </button>
                <button type="button" class="pay-card choice-card cursor-pointer rounded-2xl border border-line bg-alabaster/80 px-4 py-4 text-left dark:border-linight dark:bg-night/40" data-method="payme">
                  <span class="block font-medium">💠 Payme</span>
                  <span class="mt-1 block text-sm text-current/70">Пока заглушка: касса Payme не подключена. Слот бронируется, оплата через шлюз появится позже.</span>
                </button>
                <button type="button" class="pay-card choice-card cursor-pointer rounded-2xl border border-line bg-alabaster/80 px-4 py-4 text-left dark:border-linight dark:bg-night/40" data-method="receipt">
                  <span class="block font-medium">🧾 Перевод на карту</span>
                  <span class="mt-1 block text-sm text-current/70">Отправьте скриншот или PDF чека</span>
                </button>
              </div>
              <div id="receipt-panel" class="mt-5 hidden rounded-2xl border border-line bg-alabaster/70 p-4 dark:border-linight dark:bg-night/40">
                <p class="text-sm text-emeraldink/70 dark:text-mist/70">Переведите сумму на карту и загрузите чек (фото или PDF, до 4 МБ).</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                  <code id="card-number" class="rounded-xl bg-ivory px-3 py-2 text-sm dark:bg-dusk"><%= cardNumber %></code>
                  <button id="copy-card" type="button" class="rounded-full border border-line px-3 py-2 text-sm dark:border-linight">Скопировать</button>
                </div>
                <label class="mt-4 block text-sm">
                  Чек
                  <input id="receipt-file" type="file" accept="image/*,application/pdf" class="mt-2 block w-full text-sm" />
                </label>
              </div>
            </fieldset>

            <button
              id="submit-btn"
              type="submit"
              class="mt-10 w-full rounded-full bg-moss px-6 py-4 text-base font-medium text-ivory shadow-book transition hover:-translate-y-0.5 hover:bg-moss/90 disabled:translate-y-0 disabled:opacity-70 dark:bg-amethyst dark:text-night dark:hover:bg-amethyst/90"
            >
              Записаться бесплатно
            </button>
          </form>

          <p class="mt-6 text-sm text-emeraldink/50 dark:text-mist/45">
            <a href="/admin" class="underline decoration-gold/50 underline-offset-4">Вход для репетитора</a>
          </p>
        </section>
      </div>
    </div>
    <script>
      document.getElementById("theme-toggle").addEventListener("click", function () {
        var root = document.documentElement;
        var next = root.classList.contains("dark") ? "light" : "dark";
        root.classList.toggle("dark", next === "dark");
        localStorage.setItem("tutorbook-theme", next);
      });

      var form = document.getElementById("booking-form");
      var dateInput = document.getElementById("date");
      var slotInput = document.getElementById("time_slot");
      var slotGrid = document.getElementById("slot-grid");
      var submitBtn = document.getElementById("submit-btn");
      var teachers = <%- JSON.stringify(teachers) %>;
      var teacherIdInput = document.getElementById("teacher_id");

      function teachersForLanguage(language) {
        return teachers.filter(function (item) {
          return item.language === language;
        });
      }

      function selectedLanguage() {
        var language = selectedRadio("language");
        return language ? language.value : "";
      }

      function selectedTeacher() {
        var id = Number(teacherIdInput.value || 0);
        for (var i = 0; i < teachers.length; i += 1) {
          if (teachers[i].id === id) return teachers[i];
        }
        return null;
      }

      function updateTeacherCard() {
        var list = teachersForLanguage(selectedLanguage());
        var card = document.getElementById("teacher-card");
        var single = document.getElementById("teacher-single");
        var picker = document.getElementById("teacher-list");
        if (!list.length) {
          card.hidden = true;
          teacherIdInput.value = "";
          document.getElementById("summary-teacher").textContent = "Выберите язык";
          return;
        }
        card.hidden = false;
        var currentId = Number(teacherIdInput.value || 0);
        var stillValid = list.some(function (item) {
          return item.id === currentId;
        });
        if (!stillValid) teacherIdInput.value = String(list[0].id);
        var teacher = selectedTeacher() || list[0];
        if (list.length === 1) {
          single.hidden = false;
          picker.classList.add("hidden");
          picker.innerHTML = "";
          document.getElementById("teacher-card-name").textContent = teacher.name;
          document.getElementById("teacher-card-title").textContent = teacher.role || teacher.title || "";
        } else {
          single.hidden = true;
          picker.classList.remove("hidden");
          picker.innerHTML = "";
          list.forEach(function (item) {
            var button = document.createElement("button");
            button.type = "button";
            button.className =
              "w-full rounded-xl border px-3 py-3 text-left text-sm " +
              (item.id === teacher.id
                ? "border-moss bg-moss text-ivory dark:border-amethyst dark:bg-amethyst dark:text-night"
                : "border-line bg-alabaster/80 dark:border-linight dark:bg-night/40");
            button.innerHTML =
              "<span class=\"block font-medium\">" +
              item.name +
              "</span><span class=\"mt-1 block text-xs opacity-80\">" +
              (item.role || item.title || "") +
              "</span>";
            button.addEventListener("click", function () {
              teacherIdInput.value = String(item.id);
              updateTeacherCard();
              loadSlots();
            });
            picker.appendChild(button);
          });
        }
        document.getElementById("summary-teacher").textContent = teacher.name;
      }

      function loadSlots() {
        var date = dateInput.value;
        var language = selectedLanguage();
        var teacherId = teacherIdInput.value;
        if (!date) {
          renderSlots([], "Сначала выберите дату — появятся свободные окна.");
          return;
        }
        if (!language) {
          renderSlots([], "Сначала выберите язык, затем дату.");
          return;
        }
        renderSlots([], "Загрузка расписания…");
        var url =
          "/api/slots?date=" +
          encodeURIComponent(date) +
          "&language=" +
          encodeURIComponent(language);
        if (teacherId) url += "&teacher_id=" + encodeURIComponent(teacherId);
        fetch(url)
          .then(function (response) {
            return response.json();
          })
          .then(function (data) {
            renderSlots(
              data.available_slots || [],
              "На эту дату свободных окон нет — выходной преподавателя или все слоты заняты."
            );
          })
          .catch(function () {
            renderSlots([], "Не удалось загрузить расписание. Попробуйте ещё раз.");
          });
      }

      function selectedRadio(name) {
        return form.querySelector('input[name="' + name + '"]:checked');
      }

      function formatDate(value) {
        if (!value) return "";
        var parts = value.split("-");
        if (parts.length !== 3) return value;
        return parts[2] + "." + parts[1] + "." + parts[0];
      }

      function selectedAmount() {
        var service = selectedRadio("service");
        if (!service) return 0;
        return Number(service.closest("label").getAttribute("data-amount") || 0);
      }

      function setPayMethod(method) {
        document.getElementById("payment_method").value = method;
        Array.prototype.forEach.call(document.querySelectorAll(".pay-card"), function (card) {
          card.setAttribute("aria-pressed", card.getAttribute("data-method") === method ? "true" : "false");
          if (card.getAttribute("data-method") === method) {
            card.classList.add("border-moss", "bg-moss", "text-ivory", "dark:border-amethyst", "dark:bg-amethyst", "dark:text-night");
          } else {
            card.classList.remove("border-moss", "bg-moss", "text-ivory", "dark:border-amethyst", "dark:bg-amethyst", "dark:text-night");
          }
        });
        document.getElementById("receipt-panel").classList.toggle("hidden", method !== "receipt");
      }

      function updatePaymentStep() {
        var amount = selectedAmount();
        var step = document.getElementById("payment-step");
        if (amount > 0) {
          step.hidden = false;
          if (document.getElementById("payment_method").value === "free") setPayMethod("stripe");
          submitBtn.textContent = "Перейти к оплате";
        } else {
          step.hidden = true;
          document.getElementById("payment_method").value = "free";
          document.getElementById("receipt_data").value = "";
          submitBtn.textContent = "Записаться бесплатно";
        }
      }

      function updateSummary() {
        var language = selectedRadio("language");
        var service = selectedRadio("service");
        var date = dateInput.value;
        var time = slotInput.value;
        document.getElementById("summary-language").textContent = language ? language.value : "Не выбран";
        updateTeacherCard();
        if (service) {
          var card = service.closest("label");
          var duration = card.getAttribute("data-duration");
          document.getElementById("summary-service").textContent =
            service.value.replace(/\s*\([^)]+\)\s*$/, "") + (duration ? " · " + duration : "");
          document.getElementById("summary-price").textContent = card.getAttribute("data-price") || "—";
        } else {
          document.getElementById("summary-service").textContent = "Выберите услугу";
          document.getElementById("summary-price").textContent = "—";
        }
        updatePaymentStep();
        if (date && time) {
          document.getElementById("summary-when").textContent = formatDate(date) + " в " + time;
        } else if (date) {
          document.getElementById("summary-when").textContent = formatDate(date) + ", выберите время";
        } else {
          document.getElementById("summary-when").textContent = "Дата и время";
        }
      }

      function renderSlots(slots, message) {
        slotGrid.innerHTML = "";
        slotInput.value = "";
        if (!slots || !slots.length) {
          var hint = document.createElement("p");
          hint.id = "slot-hint";
          hint.className = "text-sm text-emeraldink/55 dark:text-mist/55";
          hint.textContent = message || "Нет свободных окон на эту дату.";
          slotGrid.appendChild(hint);
          updateSummary();
          return;
        }
        slots.forEach(function (slot) {
          var button = document.createElement("button");
          button.type = "button";
          button.className =
            "slot-pill rounded-full border border-line bg-alabaster/80 px-4 py-2 text-sm transition hover:border-moss dark:border-linight dark:bg-night/40";
          button.textContent = slot;
          button.setAttribute("aria-pressed", "false");
          button.addEventListener("click", function () {
            slotInput.value = slot;
            Array.prototype.forEach.call(slotGrid.querySelectorAll(".slot-pill"), function (pill) {
              pill.setAttribute("aria-pressed", pill === button ? "true" : "false");
            });
            updateSummary();
          });
          slotGrid.appendChild(button);
        });
        updateSummary();
      }

      dateInput.addEventListener("change", loadSlots);
      form.addEventListener("change", function (event) {
        updateSummary();
        if (event.target && event.target.name === "language") loadSlots();
      });
      Array.prototype.forEach.call(document.querySelectorAll(".pay-card"), function (card) {
        card.addEventListener("click", function () {
          setPayMethod(card.getAttribute("data-method"));
        });
      });

      document.getElementById("copy-card").addEventListener("click", function () {
        var value = document.getElementById("card-number").textContent.trim();
        var button = document.getElementById("copy-card");
        var done = function () {
          button.textContent = "Скопировано";
          setTimeout(function () {
            button.textContent = "Скопировать";
          }, 1600);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(value).then(done).catch(done);
        } else {
          done();
        }
      });

      function fileToDataUrl(file) {
        return new Promise(function (resolve, reject) {
          if (!file) return reject(new Error("no file"));
          if (file.size > 4 * 1024 * 1024) return reject(new Error("too large"));
          if (file.type === "application/pdf") {
            var reader = new FileReader();
            reader.onload = function () {
              resolve(reader.result);
            };
            reader.onerror = reject;
            reader.readAsDataURL(file);
            return;
          }
          var img = new Image();
          var url = URL.createObjectURL(file);
          img.onload = function () {
            var canvas = document.createElement("canvas");
            var width = img.width;
            var height = img.height;
            if (width > 1200) {
              height = Math.round((height * 1200) / width);
              width = 1200;
            }
            canvas.width = width;
            canvas.height = height;
            canvas.getContext("2d").drawImage(img, 0, 0, width, height);
            URL.revokeObjectURL(url);
            resolve(canvas.toDataURL("image/jpeg", 0.75));
          };
          img.onerror = reject;
          img.src = url;
        });
      }

      form.addEventListener("submit", function (event) {
        if (!form.checkValidity()) return;
        var amount = selectedAmount();
        var method = document.getElementById("payment_method").value;
        if (amount > 0 && method === "receipt") {
          var file = document.getElementById("receipt-file").files[0];
          if (!file) {
            event.preventDefault();
            alert("Загрузите скриншот или PDF чека.");
            return;
          }
          event.preventDefault();
          submitBtn.disabled = true;
          submitBtn.textContent = "Готовлю чек…";
          fileToDataUrl(file)
            .then(function (dataUrl) {
              document.getElementById("receipt_data").value = dataUrl;
              form.submit();
            })
            .catch(function () {
              submitBtn.disabled = false;
              updatePaymentStep();
              alert("Не удалось прочитать файл. Максимум 4 МБ.");
            });
          return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = "Бронирую…";
      });

      updateSummary();
    </script>
  </body>
</html>
